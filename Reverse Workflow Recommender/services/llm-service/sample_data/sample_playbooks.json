  {
    "slug": "phishing-email-investigation",
    "name": "Phishing Email Investigation",
    "category": "Phishing",
    "description": "Investigate a reported phishing email, detonate attachments/links, and notify the SOC.",
    "apps": [
      "email",
      "virustotal",
      "jira",
      "slack"
    ],
    "steps": [
      {
        "order": 1,
        "title": "Fetch reported email",
        "app": "email",
        "action": "get_email",
        "detail": "Pull the reported message and headers from the mailbox."
      },
      {
        "order": 2,
        "title": "Extract IOCs",
        "app": "http_request",
        "action": "post",
        "detail": "Parse URLs, domains, and attachment hashes from the email."
      },
      {
        "order": 3,
        "title": "Reputation lookup",
        "app": "virustotal",
        "action": "lookup_url",
        "detail": "Check extracted URLs and hashes against VirusTotal."
      },
      {
        "order": 4,
        "title": "Create ticket",
        "app": "jira",
        "action": "create_ticket",
        "detail": "Open a triage ticket with verdict and evidence."
      },
      {
        "order": 5,
        "title": "Notify SOC",
        "app": "slack",
        "action": "send_message",
        "detail": "Post the verdict and ticket link to the SOC channel."
      }
    ]
  },

{
  "id": "wf-c2-beacon-response-v1",
  "name": "C2 Beacon and Suspicious Network Traffic Response",
  "description": "Responds to C2 beacon or suspicious outbound traffic alerts from IDS/IPS or NDR. Enriches the destination IP and domain, checks for beaconing patterns, identifies the source host and process, isolates if confirmed C2, and hunts for lateral movement.",
  "start": "node_parse_alert",
  "sharing": "private",
  "tags": ["C2", "beacon", "T1071", "T1095", "T1571", "network", "lateral-movement"],
  "triggers": [
    {
      "id": "trigger_ids",
      "name": "IDS/NDR Alert",
      "app_name": "Webhook",
      "trigger_type": "WEBHOOK",
      "description": "Receives C2 or suspicious outbound traffic alert from IDS, NDR, or firewall"
    }
  ],
  "actions": [
    {
      "id": "node_parse_alert",
      "name": "Parse Network Alert",
      "app_name": "Shuffle Tools",
      "app_version": "1.2.0",
      "action": "repeat_back_to_me",
      "description": "Extract source IP, destination IP, destination domain, port, protocol, byte count, timing",
      "parameters": [{"name": "call", "value": "$exec"}],
      "position": {"x": 100, "y": 100}
    },
    {
      "id": "node_enrich_destination",
      "name": "Enrich Destination IP/Domain",
      "app_name": "VirusTotal",
      "app_version": "2.0.0",
      "action": "get_ip_report",
      "description": "Check destination IP reputation on VirusTotal for known C2 infrastructure",
      "parameters": [
        {"name": "ip", "value": "$node_parse_alert.destination_ip"}
      ],
      "position": {"x": 100, "y": 250}
    },
    {
      "id": "node_check_threat_intel",
      "name": "Check Threat Intel Feeds",
      "app_name": "MISP",
      "app_version": "1.0.0",
      "action": "search_attribute",
      "description": "Search MISP threat intelligence for matching IOCs",
      "parameters": [
        {"name": "value", "value": "$node_parse_alert.destination_ip"},
        {"name": "type", "value": "ip-dst"}
      ],
      "position": {"x": 350, "y": 250}
    },
    {
      "id": "node_identify_source_host",
      "name": "Identify Source Host and Process",
      "app_name": "CrowdStrike",
      "app_version": "1.0.0",
      "action": "get_host_network_connections",
      "description": "Identify which process on the source host is making the suspicious connection",
      "parameters": [
        {"name": "hostname", "value": "$node_parse_alert.source_hostname"}
      ],
      "position": {"x": 100, "y": 400}
    },
    {
      "id": "node_block_destination",
      "name": "Block Destination on Firewall",
      "app_name": "Palo Alto",
      "app_version": "1.0.0",
      "action": "block_ip",
      "description": "Block the C2 destination IP on the perimeter firewall",
      "parameters": [
        {"name": "ip", "value": "$node_parse_alert.destination_ip"},
        {"name": "direction", "value": "outbound"}
      ],
      "position": {"x": 350, "y": 400}
    },
    {
      "id": "node_isolate_source",
      "name": "Isolate Source Host",
      "app_name": "CrowdStrike",
      "app_version": "1.0.0",
      "action": "contain_host",
      "description": "Network-isolate the beaconing host to prevent lateral movement and further C2",
      "parameters": [
        {"name": "device_id", "value": "$node_parse_alert.source_device_id"}
      ],
      "position": {"x": 100, "y": 550}
    },
    {
      "id": "node_lateral_movement_hunt",
      "name": "Hunt for Lateral Movement",
      "app_name": "Splunk",
      "app_version": "1.0.0",
      "action": "search",
      "description": "Search SIEM for lateral movement from the compromised host in the past 24h",
      "parameters": [
        {"name": "query", "value": "index=network src=$node_parse_alert.source_ip (EventCode=4624 OR EventCode=4648) earliest=-24h"},
        {"name": "earliest_time", "value": "-24h"}
      ],
      "position": {"x": 350, "y": 550}
    },
    {
      "id": "node_create_case",
      "name": "Create IR Case",
      "app_name": "TheHive",
      "app_version": "1.0.0",
      "action": "create_case",
      "description": "Create incident case with network evidence and hunt results",
      "parameters": [
        {"name": "title", "value": "C2 Beacon: $node_parse_alert.source_hostname to $node_parse_alert.destination_ip"},
        {"name": "severity", "value": "4"},
        {"name": "tags", "value": "C2,beacon,T1071,network"}
      ],
      "position": {"x": 100, "y": 700}
    }
  ],
  "branches": [
    {"id": "b1", "source_id": "trigger_ids", "destination_id": "node_parse_alert"},
    {"id": "b2", "source_id": "node_parse_alert", "destination_id": "node_enrich_destination"},
    {"id": "b3", "source_id": "node_parse_alert", "destination_id": "node_check_threat_intel"},
    {"id": "b4", "source_id": "node_parse_alert", "destination_id": "node_identify_source_host"},
    {"id": "b5", "source_id": "node_enrich_destination", "destination_id": "node_block_destination"},
    {"id": "b6", "source_id": "node_identify_source_host", "destination_id": "node_isolate_source"},
    {"id": "b7", "source_id": "node_identify_source_host", "destination_id": "node_lateral_movement_hunt"},
    {"id": "b8", "source_id": "node_isolate_source", "destination_id": "node_create_case"},
    {"id": "b9", "source_id": "node_lateral_movement_hunt", "destination_id": "node_create_case"},
    {"id": "b10", "source_id": "node_block_destination", "destination_id": "node_create_case"}
  ]
}

# =============================================================================
# AI Recommender - environment config
# Copy to `.env` and adjust LLM_BASE_URL for your Ollama location.
#
# The LLM is EXTERNAL: your local Ollama (host or another machine), reached
# via LLM_BASE_URL. Switch URLs anytime with: bash scripts/set_ollama.sh
# =============================================================================

# ---- Postgres -----------------------------------------------------------
POSTGRES_USER=soar
POSTGRES_PASSWORD=changeme_use_a_real_secret
POSTGRES_DB=soar
PG_DSN=postgresql://soar:changeme_use_a_real_secret@postgres:5432/soar

# ---- Ollama (primary configuration) -------------------------------------
LLM_CLIENT=openai_compatible

# Pick ONE LLM_BASE_URL line:
#
# Same host as Docker (Ollama on your machine):
LLM_BASE_URL=http://host.docker.internal:11434/v1
#
# Different host on your network (replace IP/hostname):
# LLM_BASE_URL=http://10.0.0.42:11434/v1
# LLM_BASE_URL=http://gpu-box.lan:11434/v1

# Ollama ignores the API key but the OpenAI client requires a non-empty value.
LLM_API_KEY=ollama

# Models - must be pulled in your Ollama (ollama pull <model>).
EMBED_MODEL=nomic-embed-text
RERANK_MODEL=llama3.1:8b
EMBED_DIM=768

# ---- Recommender tuning -------------------------------------------------
TOP_K=5                  # how many playbook candidates to consider
KB_TOP_K=4               # how many knowledge-base chunks to include
INC_TOP_K=3              # how many past incidents to include
MIN_CONFIDENCE=6         # 1-10; drop reranks below this (raise for stricter)
LLM_TIMEOUT=120

# ---- Alternate runtimes (commented - swap LLM_BASE_URL if you ever switch)
# LM Studio:       http://host.docker.internal:1234/v1
# llama.cpp:       http://host.docker.internal:8080/v1
# vLLM / TGI:      http://gpu-box.lan:8000/v1

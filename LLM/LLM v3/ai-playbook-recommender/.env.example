# --- Core ---
SECRET_KEY=replace_with_python3_-c_import_secrets_secrets.token_hex(32)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
POSTGRES_USER=playbook
POSTGRES_PASSWORD=change_me
POSTGRES_DB=playbooks
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Vector store ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- LLM ---
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=llama3.1:8b
ENABLE_RERANKER=true

# --- Shuffle SOAR integration (leave blank to run offline/mock) ---
SHUFFLE_API_URL=
SHUFFLE_API_KEY=
SHUFFLE_ENVIRONMENT=Shuffle
SHUFFLE_ORG_ID=
SHUFFLE_VERIFY_SSL=false
SHUFFLE_SYNC_INTERVAL_MINUTES=30

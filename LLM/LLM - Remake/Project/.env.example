# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=pbuser
POSTGRES_PASSWORD=pbpass
POSTGRES_DB=playbooks
POSTGRES_URL=postgresql+asyncpg://pbuser:pbpass@postgres:5432/playbooks

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ─── Ollama / LLM ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# ─── Authentication ───────────────────────────────────────────────────────────
# IMPORTANT: Change this to a secure random string in production!
SECRET_KEY=change-this-to-a-secure-random-string-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Shuffle SOAR ─────────────────────────────────────────────────────────────
SHUFFLE_API_URL=http://your-shuffle-instance:3001
SHUFFLE_API_KEY=your-shuffle-api-key
SHUFFLE_SYNC_INTERVAL_MINUTES=30

# ─── Retrieval Weights ────────────────────────────────────────────────────────
SEMANTIC_WEIGHT=0.5
METADATA_WEIGHT=0.3
KEYWORD_WEIGHT=0.2
CONFIDENCE_LOW_THRESHOLD=0.3
CONFIDENCE_WARN_THRESHOLD=0.5

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

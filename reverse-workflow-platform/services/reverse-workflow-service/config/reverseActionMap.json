      ],
      [
        "mute_",
        "unmute_"
      ],
      [
        "associate",
        "disassociate"
      ],
      [
        "tagresource",
        "untagresource"
      ],
      [
        "grant",
        "revoke"
      ],
      [
        "assign",
        "remove"
      ]
    ],
    "needs_llm_actions": [
      "custom_action"
    ]
  },

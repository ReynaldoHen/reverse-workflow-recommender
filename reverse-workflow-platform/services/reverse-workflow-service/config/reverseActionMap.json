{
  "version": 2,
  "_doc": {
    "match": "Pencocokan memakai (app_name + action_name), action_name dinormalkan (lowercase, spasi/'-' -> '_').",
    "status": {
      "auto_mapped": "action ada di 'reversible' app -> keluarkan reverse_action",
      "requires_manual_review": "irreversibel/destruktif/update stateful/tanpa pasangan -> placeholder, jangan dikarang",
      "no_reverse_needed": "read-only/utilitas -> dilewati (tidak masuk output)",
      "needs_llm": "tak terklasifikasi -> LLM menyimpulkan; ragu -> manual"
    },
    "resolution_order": "apps[app].reversible -> apps[app].requires_manual_review -> apps[app].no_reverse_needed -> apps[app].default_status -> heuristics -> needs_llm"
  },
  "heuristics": {
    "no_reverse_prefixes": [
      "get_",
      "list_",
      "search_",
      "lookup_",
      "head_",
      "describe_",
      "post_describe",
      "post_list",
      "post_search",
      "post_fetch",
      "post_query"
    ],
    "manual_review_prefixes": [
      "put_set_",
      "put_update",
      "put_edit",
      "put_assign",
      "put_move",
      "put_resets",
      "put_remediate",
      "put_toggle",
      "put_restart",
      "put_upgrade",
      "put_run",
      "patch_",
      "update_",
      "delete_",
      "post_delete",
      "deletes_",
      "reset_",
      "post_reset",
      "post_revoke",
      "put_revoke",
      "post_commit"
    ],
    "reversible_prefix_pairs": [
      [
        "post_add_",
        "delete_"
      ],
      [
        "post_create_",
        "delete_"
      ],
      [
        "create_",
        "delete_"
      ],
      [
        "post_create",
        "post_delete"
      ],
      [
        "enable_",
        "disable_"
      ],
      [
        "block_",
        "unblock_"
      ],
      [
        "isolate_",
        "unisolate_"
      ],
      [
        "mute_",
        "unmute_"
      ],
      [
        "associate",
        "disassociate"
      ],
      [
        "tagresource",
        "untagresource"
      ],
      [
        "grant",
        "revoke"
      ],
      [
        "assign",
        "remove"
      ]
    ],
    "needs_llm_actions": [
      "custom_action"
    ]
  },

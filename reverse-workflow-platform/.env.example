# ─────────────────────────────────────────────────────────────────────────────
# Reverse Workflow Platform — environment
# Copy to .env (cp .env.example .env) and fill in the blanks. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (shared by both services) ──────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=reverser
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Neo4j ───────────────────────────────────────────────────────────────────
# For the bundled container, host is neo4j and the username must be 'neo4j'.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_DATABASE=neo4j

# ── LLM service (Python) ─────────────────────────────────────────────────────
# Signs the JWTs the orchestrator logs in to obtain. Keep stable across restarts.
LLM_SECRET_KEY=change-me-to-a-long-random-string
# Default admin account the orchestrator logs in with (see api/auth.py).
LLM_AUTH_USER=admin
LLM_AUTH_PASS=admin
# Model pulled into Ollama (see README step 3).
LLM_MODEL=llama3.1:8b

# Ollama read timeout in seconds. llama3.1:8b on CPU can take 5-15 min.
# Lower this (e.g. 120) if you have GPU. Default 900 (15 min) for CPU safety.
OLLAMA_READ_TIMEOUT=900
# Matching Node.js axios timeout (ms) = OLLAMA_READ_TIMEOUT * 1000 + 60000 overhead
LLM_CALL_TIMEOUT_MS=960000

# For Call LLm in llmService.js
LLM_API_URL=http://llm-service:8000
LLM_API_PREFIX=/api/v1

# ── Shuffle integration (optional but needed for a real end-to-end run) ──────
# The orchestrator fetches the app catalog from here and imports workflows back.
SHUFFLE_API_URL=http://shuffle-backend:5001
SHUFFLE_API_KEY=change-me-shuffle-api-key
# Optional Shuffle Cloud catalog, merged with local apps.
SHUFFLE_CLOUD_URL=
SHUFFLE_CLOUD_API_KEY=

# How long the app catalog cache is considered fresh (hours).
APP_SYNC_TTL_HOURS=24

OLLAMA_HOST=http://host.docker.internal:11434